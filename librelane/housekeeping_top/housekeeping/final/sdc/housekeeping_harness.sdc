create_clock -name clk -period 15.0000 [get_ports {clk}]
set_clock_transition 0.1500 [get_clocks {clk}]
set_clock_uncertainty 0.2500 clk
set_propagated_clock [get_clocks {clk}]
create_clock -name SCK -period 100.0000 [get_ports {SCK}]
set_clock_transition 0.1500 [get_clocks {SCK}]
set_clock_uncertainty 0.2500 SCK
set_propagated_clock [get_clocks {SCK}]
create_generated_clock -name clk_out -source [get_ports {clk}] -divide_by 1 [get_ports {clk_out}]
set_clock_transition 0.1500 [get_clocks {clk_out}]
set_clock_uncertainty 0.2500 clk_out
set_propagated_clock [get_clocks {clk_out}]
create_generated_clock -name sram_clk -source [get_ports {clk}] -combinational -divide_by 1 [get_ports {sram_clk}]
set_propagated_clock [get_clocks {sram_clk}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {SCK}]\
 -group [get_clocks {clk}]
set_clock_groups -name group2 -asynchronous \
 -group [get_clocks {SCK}]\
 -group [list [get_clocks {clk}]\
           [get_clocks {clk_out}]\
           [get_clocks {sram_clk}]]
