    for {set i 15} {$i < [expr 15 + $extra]} {incr i} {
        set letter [format %c [expr $i + 97]]
        place_pad_top spacer_${idx}${letter}	gf180mcu_ocd_io__fill1
    }
}

proc place_spacers_left {idx {extra 0}} {
    for {set i 0} {$i < 9} {incr i} {
        set letter [format %c [expr $i + 97]]
