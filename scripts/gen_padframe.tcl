label_power_pad_top pad_vdd3v3_2 vdd3v3
label_power_pad_top pad_vss5v0_2 vdd5v0
label_power_pad_top pad_vss5v0_3 vdd5v0
label_power_pad_top pad_vdd5v0_1 vdd5v0
label_power_pad_top pad_vdd5v0_2 vdd5v0
label_power_pad_top pad_vdd5v0_3 vdd5v0
label_power_pad_top pad_vdd5v0_4 vdd5v0

# Left power pins

label_power_pad_left pad_vss3v3_2 vss3v3
label_power_pad_left pad_vss5v0_4 vss5v0
label_power_pad_left pad_vss5v0_5 vss5v0
label_power_pad_left pad_vss3v3_3 vss3v3
label_power_pad_left pad_vdd3v3_3 vdd3v3
label_power_pad_left pad_vdd3v3_4 vdd3v3
label_power_pad_left pad_vss3v3_4 vss3v3

writeall force gf180mcu_padframe

# Create a cell containing just the pad labels which can be copied (flattened)
# into the final top level cell

select top cell
unexpand
set topllx [lindex $topbox 0]
set toplly [lindex $topbox 1]
set topurx [lindex $topbox 2]
set topury [lindex $topbox 3]
# bottom row
box values $topllx $toplly $topurx 100
select area m5
# left row
box values $topllx $toplly 100 $topury
select more area m5
# top row
box values $topllx $topury $topurx $topury
box grow s 100
select more area m5
# right row
box values $topurx $toplly $topurx $topury
box grow w 100
select more area m5
select save padframe_pins


# Create the user project wrapper
#
# Find the center area inside the padframe.
# Select the labels that were added above.
# Create a border around the routable area and add obstruction layers
# to prevent routing close to the padframe power rails.
#
# Note that this cell is not part of the padframe but belongs in the
# openframe top level.  It is generated here because its layout is
# dependent on how the padframe is constructed.

select top cell
expand
box grow c -350
box grow c 0.24
select area m2,m3,m4,m5
select more area via2
select more area via3
select more area via4
select less area labels
unexpand
select more area labels
select save chipalooza_frame_wrapper
load chipalooza_frame_wrapper
tech unlock *
select top cell
contact erase via
contact erase via2
contact erase via3
contact erase via4
paint comment
box grow c -0.5
erase comment
select top cell
box height 2
erase m3
paint obsm1,obsm3
select top cell
box width 2
erase m2
paint obsm1,obsm2
select top cell
box move e [box width]
box move w 2
box width 2
erase m2
paint obsm1,obsm2
select top cell
box move n [box height]
box move s 2
box height 2
erase m3
paint obsm1,obsm3

writeall force chipalooza_frame_wrapper

# quit -noprompt

